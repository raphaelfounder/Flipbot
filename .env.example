# Server-only provider credentials. Copy this file to .env.local and add the
# values there. Never prefix either secret with NEXT_PUBLIC_.
APIFY_API_TOKEN=
SOLD_COMPS_API_KEY=

# Supabase Auth. These publishable values are intentionally available to the
# browser; Row Level Security protects user-owned data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Durable Product Finder database gateway. These values stay server-only.
SUPABASE_URL=https://your-project.supabase.co
FLIPBOT_RUNTIME_URL=https://your-project.supabase.co/functions/v1/flipbot-runtime
FLIPBOT_RUNTIME_KEY=

# Stripe billing. Keep all values except public publishable keys server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=

# Self-hosted Scanner processor. Images must be deleted when processing ends.
SCANNER_PROCESSOR_URL=
SCANNER_PROCESSOR_KEY=
